{
  "manifest_version": 3,
  "name": "Neuroauth Extension",
  "key": "",
  "version": "1.0.0",
  "description": "A simple neuroauth Chrome extension",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://slysol.com/*",
    "https://*.neuroscreens.com/*",
    "https://*.neuroscreens-web.onrender.com/*",
    "https://*.neuronus.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://slysol.com/*",
        "https://*.neuroscreens.com/*",
        "https://*.neuroscreens-web.onrender.com/*",
        "https://*.neuronus.net/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}