{
  "version": "1.0.0",
  "name": "Neuro SPN",
  "description": "Chromium extension for Neuro SPN",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_scripts/content-0.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "css": []
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/IP.4d21b624.svg",
        "assets/Outfit-Variable.121d9676.ttf",
        "assets/applogo.a9a81377.svg",
        "assets/country.fe6bd23a.svg",
        "assets/fingerprint.bd97647f.svg",
        "assets/fingerprint_overrides.6cc02db7.js",
        "assets/map.c3fc7f22.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "manifest_version": 3,
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Neuro SPN",
    "default_popup": "action/index.html"
  },
  "permissions": [
    "storage",
    "proxy",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "nativeMessaging",
    "webRequest",
    "webRequestAuthProvider"
  ]
}