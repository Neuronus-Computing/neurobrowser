import("//tools/grit/grit_rule.gni")
import("//tools/grit/repack.gni")

grit("resources") {
  source = "resources.grd"
  outputs = [
    "grit/neurobrowser_ntp_resources.h",
    "grit/neurobrowser_ntp_resources_map.cc",
    "grit/neurobrowser_ntp_resources_map.h",
    "neurobrowser_ntp_resources.pak",
  ]
  output_dir = "$root_gen_dir/chrome"
}
